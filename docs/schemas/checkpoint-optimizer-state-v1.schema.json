{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration.gputpu.io/schemas/checkpoint-optimizer-state-v1.schema.json",
  "title": "Checkpoint Optimizer State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "parameter_groups", "parameters"],
  "properties": {
    "format_version": {"const": 1},
    "parameter_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameters", "options"],
        "properties": {
          "parameters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "options": {"type": "object"}
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scalars", "tensors"],
        "properties": {
          "scalars": {"type": "object"},
          "tensors": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
